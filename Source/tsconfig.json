{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "noEmit": true, "types": ["node", "vite/client"]
  },
  "include": ["main/**/*.ts", "shared/**/*.ts", "renderer/**/*.tsx", "renderer/**/*.ts", "tests-electron/**/*.ts", "*.config.ts"]
}
